rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Rule untuk koleksi events
    match /events/{event} {
      allow read: if true; // Izinkan semua orang baca agar spoiler di depan muncul
      allow write: if request.auth != null; // Hanya admin/user login yang bisa tulis
    }
    
    // Rule untuk koleksi lainnya (pendaftaran, users)
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
